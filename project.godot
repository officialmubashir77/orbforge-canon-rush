; OrbForge: Cannon Rush - Godot 4.7.2 stable
config_version=5

[application]
config/name="OrbForge: Cannon Rush"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="An original offline cannon arcade game."
config/icon="res://assets/icons/orbforge_icon.png"
run/low_processor_mode=false

[display]
window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.042, 0.1, 1)

[physics]
2d/default_gravity=1100.0

